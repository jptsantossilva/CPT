# Backend
DATABASE_URL=sqlite:///./dev.db
# Optional Alchemy API key for NFT endpoints (if empty, key can be inferred from RPC URLs /v2/<key>).
ALCHEMY_API_KEY=
# Optional OpenSea API key to prioritize OpenSea collection floor prices for NFT valuation.
OPENSEA_API_KEY=
# Optional comma-separated shared NFT contracts where contract floor should not be used as fallback.
# Example (Art Blocks shared contracts):
# 0xa7d8d9ef8d8ce8992df33d8b8cf4aebabd5bd270,0x00000007cc35dcab4a396249aefa295a8b6e16ba
NFT_SHARED_CONTRACTS=
# NFT sync scope (default focuses on Ethereum to avoid spam/rate-limit noise).
NFT_CHAINS=ethereum
# Enable/disable OpenSea calls for NFT enrichment.
NFT_OPENSEA_ENABLED=true
# Max number of OpenSea lookups per sync block (per function call set).
NFT_OPENSEA_MAX_LOOKUPS=30
# Slug patterns considered suspicious and skipped before OpenSea lookups.
NFT_SCAM_SLUG_PATTERNS=airdrop,voucher,reward,award,claim,coupon,redeem,free,mint-pass,mintpass,usdc,usdt,busd,dai,shib,yieldether,fund-eth,blaze-ether,blazeether,usdcaward,usdreward,pooledeth,usdgift,claimusd,stakingbonus,reward-position,visit
# Ethereum JSON-RPC HTTPS endpoint (e.g. Alchemy/Infura) used to sync wallet balances.
ETH_RPC_URL=
# Base JSON-RPC HTTPS endpoint (e.g. Alchemy Base) used to sync Base wallet balances.
BASE_RPC_URL=
# Polygon JSON-RPC HTTPS endpoint (e.g. Alchemy Polygon) used to sync Polygon wallet balances.
POLYGON_RPC_URL=
# Primary Solana JSON-RPC HTTPS endpoint (recommended: your Alchemy Solana endpoint).
SOLANA_RPC_URL=
# Solana public fallback RPC endpoint used only if primary endpoint fails.
SOLANA_RPC_FALLBACK_URL=https://api.mainnet.solana.com
# Solana token metadata list (mint -> symbol/name) used to resolve SPL tokens.
SOLANA_TOKEN_LIST_URL=https://tokens.jup.ag/tokens
# Solana token metadata single-mint lookup (used when mint is missing from token list).
SOLANA_TOKEN_LOOKUP_URL_TEMPLATE=https://lite-api.jup.ag/tokens/v1/token/{mint}
# Optional Bitcoin API base URL used to sync BTC wallet balances.
BTC_API_BASE=https://blockstream.info/api
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# Optional
PORT=8000
# Max worker threads for sync network calls (wallet balances + NFTs). Range: 1..16
SYNC_MAX_WORKERS=6
# Docker production database credentials
POSTGRES_DB=cpt
POSTGRES_USER=cpt
POSTGRES_PASSWORD=change_me
# Encryption key for secrets (Fernet). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
